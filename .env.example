# Sanity CMS — leave blank to use the static demo menu
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional, only for a private dataset. Server-side only — never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# Table QR codes point to this origin
NEXT_PUBLIC_SITE_URL=https://maison-zaytoun.vercel.app

# Microsoft Clarity — public site ID (script tag) and server-only export API token
NEXT_PUBLIC_CLARITY_ID=
CLARITY_API_TOKEN=
